# syntax=docker/dockerfile:1-labs
# This Dockerfile builds the self-hosted version of the Convex backend
# It creates a minimal runtime image that can run a local Convex instance

ARG VERGEN_GIT_SHA
ARG VERGEN_GIT_COMMIT_TIMESTAMP

# cargo-chef is used to cache Rust dependencies and build artifacts
# It creates a recipe of our dependencies first, then builds them in a separate stage
# This helps avoid rebuilding dependencies when only first-party source code changes
FROM lukemathwalker/cargo-chef:latest-rust-1 AS chef
WORKDIR /tmp
COPY rust-toolchain .
# Dummy command to just fetch the toolchain that'll get installed by running `cargo chef`
RUN rustup self update && rustup toolchain install
COPY --parents crates* Cargo* ./
RUN cargo chef prepare --recipe-path recipe.json --bin convex-local-backend

# Build stage: Compiles the Rust backend with all dependencies
# Uses cargo-chef's recipe from the previous stage for optimal caching
FROM lukemathwalker/cargo-chef:latest-rust-1 AS build
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Update APT configuration for Docker builds
# Sets retry attempts, assumes yes for prompts, and configures dpkg timeout
# Also installs a few libraries needed for building the backend
RUN <<EOF
printf 'APT::Acquire::Retries \"10\";\n' > /etc/apt/apt.conf.d/80retries
printf 'APT::Get::Assume-Yes \"true\";\n' > /etc/apt/apt.conf.d/90forceyes
printf 'DPkg::Lock::Timeout \"30\";\n' > /etc/apt/apt.conf.d/85timeout
echo 'DEBIAN_FRONTEND=noninteractive' > /etc/environment
apt-get update
apt-get install -y --no-install-recommends cmake libclang-dev libstdc++6 libc6
EOF

# Install Just (for build scripts)
RUN cargo install just

WORKDIR /

# Install Node.js from NodeSource repository
# We extract the version from .nvmrc
COPY .nvmrc /nvmrc
RUN <<EOF
# Extract major version (e.g., "18" from "18.x.x")
NODE_MAJOR=$(cat /nvmrc | cut -d. -f1 | tr -d 'v\n')
# Add NodeSource repository and its signing key
curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash -
# Install the specific version listed in the nvmrc file
NODE_VERSION=$(cat /nvmrc | tr -d 'v\n')
apt-get install -y --no-install-recommends nodejs=${NODE_VERSION}-1nodesource1
EOF

# The git-hosted docusaurus-openapi-docs dependency (allowlisted in
# pnpm-workspace.yaml onlyBuiltDependencies) runs `yarn install` in its
# prepare step, so pnpm install needs yarn on PATH. CI runners preinstall
# it; this image doesn't.
RUN npm install -g yarn

# Ensure this file is copied so we'll restart here if the file changes
COPY rust-toolchain /rust-toolchain
# Dummy command to just fetch the toolchain and cargo index
RUN rustup self update && rustup toolchain install && cargo search -q convex

WORKDIR /convex
COPY scripts ./scripts
RUN npm ci --prefix scripts/

COPY npm-packages ./npm-packages
COPY Justfile ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store,sharing=locked just install-js

# Provision protoc via mise before the cargo layers (version + checksum from
# mise.toml/mise.lock; mise's own version from min_version). mise lives only in
# this build stage, never the runtime image. $PROTOC is set per cargo RUN below
# so it's available to both `cargo chef cook` and the real build.
COPY mise.toml mise.lock ./
ENV MISE_INSTALL_PATH="/usr/local/bin/mise" \
    MISE_DATA_DIR="/mise" \
    MISE_CONFIG_DIR="/mise" \
    MISE_CACHE_DIR="/mise/cache"
RUN curl -fsSL https://mise.run | MISE_VERSION="v$(sed -nE 's/^min_version = "([^"]+)"/\1/p' mise.toml)" sh \
    && mise trust && mise install --locked protoc

# Cargo reads .cargo/config.toml (e.g. RUSTY_V8_MIRROR, which redirects the V8
# static-lib download to our fork) via hierarchical discovery from the working
# directory, so it must be present before `cargo chef cook` builds dependencies.
COPY .cargo/config.toml ./.cargo/config.toml

# sccache, pinned to the version .github/actions/setup-rust already uses for the
# non-Docker jobs. It caches individual rustc invocations keyed on compiler
# inputs, which is the property the Docker layer cache does not have: any change
# to Cargo.lock invalidates the cook layer wholesale, and this fork merges
# upstream hourly, so that happens often. With sccache the ~490 dependencies
# whose inputs did not change are fetched instead of rebuilt even when the layer
# misses. Output is unaffected -- sccache replays the exact compiler artefact.
ARG TARGETARCH
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) sccache_arch=x86_64 ;; \
      arm64) sccache_arch=aarch64 ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    url="https://github.com/mozilla/sccache/releases/download/v0.16.0/sccache-v0.16.0-${sccache_arch}-unknown-linux-musl.tar.gz"; \
    curl -fsSL "$url" -o /tmp/sccache.tar.gz; \
    tar -xzf /tmp/sccache.tar.gz -C /tmp; \
    mv /tmp/sccache-v0.16.0-${sccache_arch}-unknown-linux-musl/sccache /usr/local/bin/sccache; \
    chmod +x /usr/local/bin/sccache; \
    rm -rf /tmp/sccache.tar.gz /tmp/sccache-v0.16.0-*

# Turns the mounted R2 credentials into an sccache server and echoes the env
# that enables it, or echoes nothing at all. Sourced by both cargo layers below.
#
# Fail-open by construction: a missing secret, an unreachable bucket or a server
# that will not start leaves RUSTC_WRAPPER unset and the build simply compiles
# without the cache. A compile cache must never be able to turn a slow release
# into a failed one -- the same rule .github/actions/setup-rust follows.
COPY self-hosted/docker-build/sccache-env.sh /usr/local/bin/sccache-env
RUN chmod +x /usr/local/bin/sccache-env

COPY --from=chef /tmp/recipe.json recipe.json
# Use cargo-chef to build dependencies from the recipe created in the first stage
# This step will be cached unless dependencies change
#
# Fork divergence: upstream wraps this (and the real build below) in
# `--mount=type=cache` for target/, the cargo registry and the git db. That is
# right for a persistent builder and actively harmful on the ephemeral CI
# runners this fork releases from, because a cache mount is NOT part of the
# layer and so is never exported by `cache-to`. On a fresh runner the mount
# starts empty, which makes a cache *hit* worse than a miss: BuildKit restores
# this layer from S3, sees it as satisfied and skips the cook entirely, and
# then the build layer below runs against an empty target/ and recompiles all
# ~1000 dependencies from scratch. That was the whole ~44 min of this job.
#
# Without the mounts, cook's output lands in the layer, `cache-to mode=max`
# exports it, and the next release restores warm dependencies and compiles
# only the workspace crates that actually changed. The mounts must be removed
# from both cargo RUNs, not just this one: a mount on the second RUN would
# shadow the baked-in directories and put us back to an empty target/.
#
# This cannot affect the published image. Everything here is the `build`
# stage; the final stage starts `FROM ubuntu:noble` and copies only the two
# binaries out, so image content and size are byte-for-byte unchanged.
# Quoted heredoc: with an unquoted `<<EOF` the Dockerfile parser expands
# `${...}` itself and a `\$` escape survives into the shell as a literal
# backslash-dollar, which silently turned `export PROTOC="$(mise which protoc)"`
# into the literal string `$(mise which protoc)` and broke prost-build. `<<'EOF'`
# disables Dockerfile expansion entirely, so the shell receives exactly this.
RUN --mount=type=secret,id=r2_access_key --mount=type=secret,id=r2_secret_key \
    --mount=type=secret,id=r2_endpoint --mount=type=secret,id=r2_bucket <<'EOF'
set -e
eval "$(sccache-env)"
export PROTOC="$(mise which protoc)"
cargo chef cook --release --recipe-path recipe.json
if [ -n "${RUSTC_WRAPPER:-}" ]; then sccache --show-stats || true; fi
EOF
# Now copy everything else over -- we've minimized the set of files that cause a full `pnpm install` or `cargo build` to run.
COPY . .

# Build the convex-local-backend binary
# Must redeclare these as environment variables so that they are available
ARG VERGEN_GIT_SHA
ARG VERGEN_GIT_COMMIT_TIMESTAMP
ENV VERGEN_GIT_SHA=${VERGEN_GIT_SHA}
ENV VERGEN_GIT_COMMIT_TIMESTAMP=${VERGEN_GIT_COMMIT_TIMESTAMP}
# The cargo mounts are deliberately absent here — see the cook layer above.
# They must match that layer exactly, or a mount here shadows the warm
# target/, registry and git db baked into it and forces a full recompile.
RUN --mount=type=cache,target=/root/.local/share/pnpm/store,sharing=locked \
    --mount=type=secret,id=r2_access_key --mount=type=secret,id=r2_secret_key \
    --mount=type=secret,id=r2_endpoint --mount=type=secret,id=r2_bucket <<'EOF'
set -e
eval "$(sccache-env)"
export PROTOC="$(mise which protoc)"
cargo build --release -p local_backend --bin convex-local-backend
cp target/release/convex-local-backend .
cargo build --release -p keybroker --bin generate_key
cp target/release/generate_key .
if [ -n "${RUSTC_WRAPPER:-}" ]; then sccache --show-stats || true; fi
EOF
ARG debug
RUN if [[ -z "$debug" ]]; then strip ./convex-local-backend; strip ./generate_key; fi

# Final stage: Creates minimal runtime image with only necessary components
# Uses Ubuntu Noble (24.04) as the base image
FROM ubuntu:noble
ARG VERGEN_GIT_SHA
LABEL org.opencontainers.repository=https://github.com/get-convex/convex-backend
LABEL org.opencontainers.image.revision=${VERGEN_GIT_SHA}

WORKDIR /convex

# Install libraries needed for running the backend
RUN --mount=type=cache,target=/var/cache/apt --mount=type=cache,target=/var/lib/apt,sharing=locked <<EOF
apt-get update
apt-get install -y --no-install-recommends libclang1 curl ca-certificates
EOF

# Install Node.js and npm, required for running Node.js actions in the backend
COPY --from=build /usr/bin/node /usr/bin/node
COPY --from=build /usr/bin/npm /usr/bin/npm
COPY --from=build /usr/lib/node_modules/npm /usr/lib/node_modules/npm
# Set up npm and npx commands
RUN ln -sf /usr/lib/node_modules/npm/bin/npm-cli.js /usr/bin/npm && \
    chmod +x /usr/bin/npm
RUN ln -sf /usr/lib/node_modules/npm/bin/npx-cli.js /usr/bin/npx && \
    chmod +x /usr/bin/npx
COPY --from=build --chmod=744 /convex/convex-local-backend .
COPY --from=build --chmod=744 /convex/generate_key .
COPY --chmod=744 self-hosted/docker-build/read_credentials.sh .
COPY --chmod=744 self-hosted/docker-build/run_backend.sh .
COPY --chmod=744 self-hosted/docker-build/generate_admin_key.sh .

VOLUME /convex/data

# Set the backend as the executable
ENTRYPOINT ["./run_backend.sh"]

# Expose the required ports
EXPOSE 3210
EXPOSE 3211
